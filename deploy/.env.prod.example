# 生产环境：只用 docker-compose.yml，MySQL/Redis/Kafka用托管服务，这里填它们的连接信息。
# 用法：cp deploy/.env.prod.example deploy/.env ，把所有CHANGE_ME换成真实值后
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d
# 这个文件里有密码，**不要提交到git**(deploy/.env已经在.gitignore里)

TZ=UTC
# 建议用具体的版本号或提交哈希，不要用latest，这样回滚时能精确回到上一个版本
IMAGE_TAG=CHANGE_ME

# ---- 对宿主机发布的端口 ----
# 目前没有鉴权(见docs/auth-design.md)，默认只绑回环地址，前面必须有带鉴权和TLS的网关。
# 网关跟这台机器通网时再改成内网地址；**不要直接绑0.0.0.0暴露到公网**
BIND_ADDR=127.0.0.1
API_PORT=7001
ENGINE_PORT=7002

# ---- 托管的依赖服务 ----
# MySQL 8.x：先用sql/schema.sql初始化库，用户只需要perpgo库的读写权限。
# loc=UTC要跟TZ保持一致
PERP_MYSQL_DSN=CHANGE_ME_USER:CHANGE_ME_PASSWORD@tcp(CHANGE_ME_HOST:3306)/perpgo?parseTime=true&loc=UTC
PERP_REDIS_ADDR=CHANGE_ME_HOST:6379
PERP_REDIS_PASS=CHANGE_ME
PERP_KAFKA_BROKER=CHANGE_ME_HOST:9092

# ---- 接口鉴权(API Key + HMAC签名，见docs/auth-design.md) ----
# 格式 id:secret:权限，多把用逗号分隔。权限：trade=交易和查询类接口，ops=运营类接口(加钱扣钱、
# 发信用额度、设投保、喂指数价)。**建议给合作方业务后端和行情/运营来源分别发不同的密钥**：
# 交易密钥只给trade，喂指数价的来源只给ops。secret用 openssl rand -hex 24 生成(至少16位，
# 里面不能有 : , | )。**绝对不要设PERP_AUTH_DISABLED=true**
# secret 处的 CHANGE_ME 不换成随机串，进程会拒绝启动
PERP_API_KEYS=CHANGE_ME_ID:CHANGE_ME:trade
PERP_AUTH_DISABLED=false

# ---- 应用 ----
API_NODE_ID=0
ENGINE_NODE_ID=1
PERP_ENGINE_SYMBOLS=
