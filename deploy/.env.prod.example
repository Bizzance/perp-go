# 生产环境：只用 docker-compose.yml，MySQL/Redis/Kafka用托管服务，这里填它们的连接信息。
# 用法：cp deploy/.env.prod.example deploy/.env ，把所有CHANGE_ME换成真实值后
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d
# 这个文件里有密码，**不要提交到git**(deploy/.env已经在.gitignore里)

TZ=UTC
# 建议用具体的版本号或提交哈希，不要用latest，这样回滚时能精确回到上一个版本
IMAGE_TAG=CHANGE_ME

# ---- 对宿主机发布的端口 ----
# 目前没有鉴权(见docs/auth-design.md)，默认只绑回环地址，前面必须有带鉴权和TLS的网关。
# 网关跟这台机器通网时再改成内网地址；**不要直接绑0.0.0.0暴露到公网**
BIND_ADDR=127.0.0.1
API_PORT=7001
ENGINE_PORT=7002

# ---- 托管的依赖服务 ----
# MySQL 8.x：先用sql/schema.sql初始化库，用户只需要perpgo库的读写权限。
# loc=UTC要跟TZ保持一致
PERP_MYSQL_DSN=CHANGE_ME_USER:CHANGE_ME_PASSWORD@tcp(CHANGE_ME_HOST:3306)/perpgo?parseTime=true&loc=UTC
PERP_REDIS_ADDR=CHANGE_ME_HOST:6379
PERP_REDIS_PASS=CHANGE_ME
PERP_KAFKA_BROKER=CHANGE_ME_HOST:9092

# ---- 接口鉴权(API Key + HMAC签名，见docs/auth-design.md) ----
# 格式 id:secret:权限，多把用逗号分隔，权限用|分隔：trade=交易和查询类接口，ops=运营类接口(加钱扣钱、
# 发信用额度、设投保、喂指数价)。这里只用一把trade|ops全权限密钥，orderbook-sync也用它推指数价/K线；
# 想按最小权限原则给不同来源分开发密钥(合作方业务只给trade、行情来源只给ops)，加一把就行，见docs/auth-design.md。
# secret用 openssl rand -hex 24 生成(至少16位，里面不能有 : , | )。**绝对不要设PERP_AUTH_DISABLED=true**
# secret 处的 CHANGE_ME 不换成随机串，进程会拒绝启动
PERP_API_KEYS=CHANGE_ME_ID:CHANGE_ME:trade|ops
PERP_AUTH_DISABLED=false

# ---- 应用 ----
API_NODE_ID=0
ENGINE_NODE_ID=1
PERP_ENGINE_SYMBOLS=

# ---- 标记价(强平、盈亏、条件单触发、资金费率共同依赖，见docs/mark-price.md) ----
# 生产必须为true：没有指数价就不产生标记价，不会退回可以被自成交操纵的最新成交价。
# 开启后必须持续往POST /index-price喂指数价(ops权限)，喂价断了(超过MAX_INDEX_AGE_SEC)强平会暂停并告警
PERP_MARK_REQUIRE_INDEX=true
# 下面三项留空用默认值：指数价30秒没更新算断供；标记价最多偏离指数价1%；盘口基差取60秒窗口的平均
PERP_MARK_MAX_INDEX_AGE_SEC=
PERP_MARK_MAX_DEVIATION=
PERP_MARK_BASIS_WINDOW_SEC=
# POST /index-price的服务端跳变保护：一次推送相对当前指数价变动超过5%，先不写，新价位持续3秒才承认。
# 防的是ops密钥泄露或行情源出错时一步把指数价推到离谱的位置，真实的闪崩只会被延迟几秒。留空=不校验(不建议)
PERP_INDEX_MAX_JUMP=0.05
PERP_INDEX_JUMP_CONFIRM_SEC=
# K线的来源：external=K线只来自币安(orderbook-sync同步)，我们自己的成交不再写K线，K线和24h统计等于币安的数据。
# 生产用orderbook-sync，必须设external，否则POST /kline/sync会被拒绝，K线是空的。api和engine读的是同一个变量
PERP_KLINE_SOURCE=external

# ---- 订单簿镜像(contract-engine进程内部直接调用账户/撮合服务，不经HTTP，不用配密钥)，见docs/orderbook-sync.md ----
# **生产必须配置PERP_MIRROR_SYMBOLS**：它把币安的订单簿直接镜像成系统账户的真实挂单，用户下单吃的就是这些挂单，
# 没有它订单簿是空的、用户下单没有对手方。系统账户uid是固定值、不需要配置，由contract-engine自己创建，
# 不需要充值/维护余额(它的保证金冻结永远无条件成功，也不会被强平)，不用像合作方账户那样先调POST /account/create
PERP_MIRROR_SYMBOLS=BTCUSDT,ETHUSDT
# 下面留空用默认值：每侧镜像币安前50档；每1000毫秒一轮；挂单杠杆5；币安数据10秒没更新就撤单暂停报价
PERP_MIRROR_LEVELS=
PERP_MIRROR_INTERVAL_MS=
PERP_MIRROR_LEVERAGE=
PERP_MIRROR_STALE_SEC=
PERP_MIRROR_BINANCE_URL=

# ---- 订单簿同步(orderbook-sync，只剩指数价和K线，见docs/orderbook-sync.md) ----
COMPOSE_PROFILES=booksync
# 生产必须开：COMPOSE_PROFILES=booksync 会一起拉起这个进程，把币安的指数价推给api(标记价靠它做锚，没有它
# 生产环境没有标记价，市价单和强平都不能用)，把币安的K线推给api(合作方拿到的K线就是币安的)。
# 复用上面PERP_API_KEYS里的同一把密钥(只需要ops权限，这把已经是trade|ops，够用)。
# 币安部分地区返回451，部署前要确认能访问
BOOKSYNC_API_KEY_ID=CHANGE_ME_ID
BOOKSYNC_API_SECRET=CHANGE_ME
# 下面留空用默认值：合约BTCUSDT,ETHUSDT；每1000毫秒推一次指数价
BOOKSYNC_SYMBOLS=
BOOKSYNC_INTERVAL_MS=
# K线每2秒同步一次最近几根，启动时补500根历史（币安接口上限1500），留空用默认值
BOOKSYNC_KLINE_INTERVAL_SEC=
BOOKSYNC_KLINE_BACKFILL=
