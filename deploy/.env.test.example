# 测试/联调环境：配合 docker-compose.deps.yml 使用，依赖都在compose内部网络里，开箱即用。
# 用法：cp deploy/.env.test.example deploy/.env ，按需改密码，再生成API密钥(见下面PERP_API_KEYS)后
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml -f deploy/docker-compose.deps.yml up -d --build
# 密码里不要出现 @ : / 这类会破坏DSN格式的字符，用字母数字最省事

TZ=UTC
IMAGE_TAG=latest

# ---- 对宿主机发布的端口(依赖的端口不发布) ----
BIND_ADDR=127.0.0.1
API_PORT=7001
ENGINE_PORT=7002

# ---- 依赖服务(compose内部主机名) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=perpgo
MYSQL_PASSWORD=change-me-mysql
PERP_MYSQL_DSN=perpgo:change-me-mysql@tcp(mysql:3306)/perpgo?parseTime=true&loc=UTC
PERP_REDIS_ADDR=redis:6379
PERP_REDIS_PASS=change-me-redis
PERP_KAFKA_BROKER=kafka:9092

# ---- 接口鉴权(API Key + HMAC签名，见docs/auth-design.md) ----
# 格式 id:secret:权限，多把用逗号分隔，权限用|分隔：trade=交易和查询类接口，ops=运营类接口
# (加钱扣钱、发信用额度、设投保、喂指数价)。secret至少16位，里面不能有 : , | 这三个字符。
# secret 处是占位符 CHANGE_ME，**必须换成随机串，否则进程拒绝启动**(防止带着写在仓库里的密钥上线)：
#   sed -i "s/CHANGE_ME/$(openssl rand -hex 24)/" deploy/.env
PERP_API_KEYS=partner-a:CHANGE_ME:trade|ops
# 联调时想跳过鉴权可以设成true，只能用在本地，不要提交到共享环境
PERP_AUTH_DISABLED=false

# ---- 应用 ----
# 每个实例的node id必须互不相同(雪花ID用)，见docs/deployment.md
API_NODE_ID=0
ENGINE_NODE_ID=1
# 留空=这个engine实例负责全部symbol(单实例默认)。分片时填逗号分隔的symbol列表，
# 且每个实例的ENGINE_NODE_ID必须显式设置且互不相同，见docs/engine-sharding.md
PERP_ENGINE_SYMBOLS=

# ---- 标记价(见docs/mark-price.md) ----
# 测试环境默认false：没有喂过指数价的合约标记价退回最新成交价，这样不接行情源也能测下单成交。
# 接了sim-client做市(它会持续喂指数价)后标记价自动跟着指数价走；想验证生产行为可以设true
PERP_MARK_REQUIRE_INDEX=false
# POST /index-price的服务端跳变保护，测试环境留空=不校验：模拟客户端的行情情景会故意大幅改价，
# 页面上的手动喂价框也是。想验证生产行为可以设0.05，见docs/mark-price.md
PERP_INDEX_MAX_JUMP=
PERP_INDEX_JUMP_CONFIRM_SEC=
# 订单簿同步(orderbook-sync)测试环境默认不开：测试用模拟客户端的做市(它也会往订单簿里挂币安的盘口，还带行情情景偏移)，
# 两者用同一段系统账户uid，不能同时跑。想在测试环境验证同步进程，先不要开sim-client的-maker，
# 再设COMPOSE_PROFILES=booksync并配BOOKSYNC_*(密钥要同时有trade和ops权限)，见docs/orderbook-sync.md
